# Copy to .env (never commit it) or set these in your cloud host's settings.

# The address people use to reach the hub, e.g. https://hub.meadowbrook.church
PUBLIC_URL=

# The church app's own address (optional), e.g. https://app.meadowbrook.church.
# Without it, the app is at PUBLIC_URL/app/.
MB_APP_URL=

# Google sign-in (see README → Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=meadowbrook.church

# Email for sign-in codes (see README → Email). Gmail/Workspace: an app password.
MB_SMTP_USER=
MB_SMTP_PASS=
# MB_MAIL_FROM=Meadowbrook Church

# Comma-separated emails that are always admins (the first person to sign in also becomes admin).
MB_ADMIN_EMAILS=

# Where data lives (defaults shown)
# MB_DB=data/meadowbrook.db
# MB_UPLOADS=data/uploads
# PORT=8090

# Test sign-in without Google. NEVER turn this on for the live site.
# MB_DEV_LOGIN=1

# Video calls in chats (daily.co). Settings → Church → Video calls sets a monthly minutes limit.
MB_DAILY_API_KEY=

# Giving (stripe.com): Developers → API keys, and the webhook's signing secret.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Nightly backups (Settings → Backups). The password locks every backup; keep a copy somewhere safe.
MB_BACKUP_PASSWORD=
# Where the last 3 copies stay on disk (default: a "backups" folder next to MB_DB).
# MB_BACKUP_DIR=
